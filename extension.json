{
    "name": "laveroadmin/helpers",
    "title": {
        "en": "Development Helpers",
        "ru": "Помощники разработки"
    },
    "description": {
        "en": "Scaffolding tools, CRUD controller & model generator, and database schema inspector.",
        "ru": "Инструменты кодогенерации, генератор CRUD-контроллеров, моделей и инспектор таблиц БД."
    },
    "category": "tools",
    "icon": "icon-cogs",
    "version": "1.0.0",
    "author": {
        "name": "Aleksandr Kireev",
        "email": "hello@bespredel.name",
        "url": "https://bespredel.name"
    },
    "github": "https://github.com/LaveroAdmin/helpers",
    "setup": {
        "commands": [
            {
                "cmd": "php artisan admin:import helpers",
                "desc": {
                    "en": "Import scaffolding menu items and routes",
                    "ru": "Импорт меню и маршрутов скаффолдинга"
                }
            }
        ],
        "config": {
            "file": "config/admin.php",
            "code": "'helpers' => [\n    'enable' => env('APP_ENV') === 'local',\n],"
        },
        "requirements": {
            "en": [
                "PHP >= 8.1"
            ],
            "ru": [
                "PHP >= 8.1"
            ]
        },
        "notes": {
            "en": [
                "Recommended to enable only in local development environments (APP_ENV=local)."
            ],
            "ru": [
                "Рекомендуется включать только в локальном dev-окружении (APP_ENV=local)."
            ]
        }
    },
    "key": "helpers",
    "compatibility": {
        "php": ">=8.1",
        "laravel": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "admin": "^1.0",
        "extensions": [
            "pdo"
        ]
    }
}
